# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Python / Django ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.sqlite3
*.log
/marking/*.dll

# Marking site generated output
*.pdf
*.csv
*.7z

# The exported Next.js bundle (marking/briefs/bundle/) is deliberately NOT
# ignored: committing it is what lets a release be a pull plus a restart on a
# server with no Node installed. Rebuild it with `npm run build:install`.

# ── Node / Next.js (frontend/) ───────────────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/frontend/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

CLAUDE.md
AGENTS.md
.claude
